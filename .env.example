# ─────────────────────────────────────────────────────────────
# AI-KEN configuration. Copy to backend/.env (or the project root .env)
# and fill in the values. NEVER commit the real .env file.
# Secrets are read only by the backend and never sent to the browser.
# ─────────────────────────────────────────────────────────────

# development | production   (development shows dev-only reset links and /api/docs)
APP_ENV=development
# Public URL of the site (used in password-reset emails)
PUBLIC_URL=http://localhost:5173
# Long random string. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Set true when served over HTTPS (production)
COOKIE_SECURE=false
SESSION_DAYS=7
# Only needed if the frontend is served from a different origin than the API
CORS_ORIGINS=http://localhost:5173

# Database — SQLite by default; use PostgreSQL / Supabase Postgres in production:
# DATABASE_URL=postgresql://user:password@host:5432/aiken
DATABASE_URL=

# ── Language model (required for poem generation) ──
# anthropic (default) or openai (any OpenAI-compatible API: OpenAI, Groq, OpenRouter, Ollama, Gemini...)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# Local, free option with Ollama:  LLM_PROVIDER=openai  OPENAI_BASE_URL=http://localhost:11434/v1  OPENAI_MODEL=llama3.1
LLM_TIMEOUT=90

# ── Embeddings for RAG retrieval ──
# local  = offline lexical embeddings, no key needed (works out of the box)
# openai = any OpenAI-compatible /embeddings endpoint (recommended for semantic retrieval)
EMBEDDING_PROVIDER=local
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# Voyage AI: EMBEDDING_BASE_URL=https://api.voyageai.com/v1  EMBEDDING_MODEL=voyage-3.5
# After changing the embedding model: Admin → AI & Knowledge Base → Reprocess all

# ── English dictionary lookups (free, no key) ──
ENABLE_EXTERNAL_DICTIONARY=true
ENGLISH_DICTIONARY_API=https://api.dictionaryapi.dev/api/v2/entries/en/

# ── Email for password resets (optional in development) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AI-KEN <no-reply@yourdomain.com>

# ── First administrator (created on startup only if no admin exists) ──
ADMIN_EMAIL=lontockenjohn@gmail.com
ADMIN_PASSWORD=Admin1234
ADMIN_NAME=AI-KEN Administrator
